#!/usr/bin/env bash
# wait-ci <n>: wait for PR <n>'s checks; on failure, print the failing log lines.
source "$(dirname "$0")/_lib.sh"
[ $# -eq 1 ] || die "usage: wait-ci <n>"
if ghq pr checks "$1" --watch --interval 15 >/dev/null; then
  ghq pr checks "$1" | awk -F'\t' '{print $1": "$2" ("$3")"}'
  exit 0
fi
ghq pr checks "$1" | awk -F'\t' '{print $1": "$2" ("$3")"}'
run="$(ghq pr checks "$1" --json link,state --jq '.[] | select(.state=="FAILURE") | .link' \
  | head -1 | sed -E 's#.*/runs/([0-9]+).*#\1#')"
[ -n "$run" ] && ghq run view "$run" --log-failed | grep -E 'error|Error' | head -30
die "CI failed on #$1"
